# ─── Chains ────────────────────────────────────────────────────────────────
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBISCAN_API_KEY=

# ─── Modes ─────────────────────────────────────────────────────────────────
USDG_MODE=mock            # mock | official
STOCK_TOKEN_MODE=mock     # mock | official
PERP_MODE=gmx             # gmx | mock

# ─── Keys (testnet only; never commit real keys) ───────────────────────────
DEPLOYER_PK=
OPERATOR_PK=
AGENT_SIGNER_PK=
DEPOSITOR_PK=
WATCHER_PK=
PRICE_UPDATER_PK=

# ─── LLM ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_MODE=replay           # live | replay
LLM_RECORD=0

# ─── Services ──────────────────────────────────────────────────────────────
SERVER_PORT=4000
AGENT_PORT=4100
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
DEMO_ADMIN_TOKEN=change-me-local-only

# ─── Protocol timing (seconds) ─────────────────────────────────────────────
WARN_COOLDOWN_SECONDS=120
SETTLE_GRACE_SECONDS=300
BOND_COOLDOWN_SECONDS=300
