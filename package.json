{
  "name": "velanos",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "contracts:build": "pnpm --filter @velanos/contracts build && tsx scripts/generate-abis.ts",
    "contracts:test": "pnpm --filter @velanos/contracts test",
    "contracts:deploy:rh": "pnpm --filter @velanos/contracts deploy:rh",
    "contracts:deploy:arb": "pnpm --filter @velanos/contracts deploy:arb",
    "demo:seed": "pnpm --filter @velanos/contracts seed",
    "demo:preflight": "tsx scripts/demo-preflight.ts",
    "demo:run": "tsx scripts/demo-run.ts",
    "demo:all": "tsx scripts/demo-run.ts all",
    "docs:addresses": "tsx scripts/docs-addresses.ts",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "abis": "tsx scripts/generate-abis.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "viem": "^2.57.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
